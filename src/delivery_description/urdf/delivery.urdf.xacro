<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="delivery_robot">

  <!-- include utils FIRST -->
  <xacro:include filename="$(find delivery_description)/urdf/utils.xacro"/>

  <!-- params (meters) -->
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_separation" value="0.36"/>
  <xacro:property name="wheel_y" value="${wheel_separation/2.0}"/>

  <!-- LiDAR pose (meters + degrees) -->
  <xacro:property name="lidar_x" value="0.15"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.20"/>

  <!-- degrees only -->
  <xacro:property name="lidar_roll_deg"  value="0"/>
  <xacro:property name="lidar_pitch_deg" value="0"/>
  <xacro:property name="lidar_yaw_deg"   value="0"/>

  <!-- include parts -->
  <xacro:include filename="$(find delivery_description)/urdf/base.xacro"/>
  <xacro:include filename="$(find delivery_description)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find delivery_description)/urdf/lidar.xacro"/>

  <!-- call macros -->
  <xacro:base/>
  <xacro:wheels wheel_y="${wheel_y}" wheel_radius="${wheel_radius}"/>
  <xacro:lidar
    lidar_x="${lidar_x}" lidar_y="${lidar_y}" lidar_z="${lidar_z}"
    lidar_roll_deg="${lidar_roll_deg}" lidar_pitch_deg="${lidar_pitch_deg}" lidar_yaw_deg="${lidar_yaw_deg}"/>

</robot>
